# Reference list of the provider API key names AI Lab recognizes.
#
# This file is NOT read directly by the app. Copy the keys you need into the
# .env file in the app's data directory instead (default: src/AiLab.Api/data/.env,
# or $AILAB_DATA_DIR/.env if you override the data directory) — or run
# `dotnet run --project src/AiLab.Api -- configure` to set them interactively.
# See "Configure provider credentials" in README.md for details.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
